{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% assign footer_lang = site.active_lang | default: site.default_lang %}
  {% if site.impressum_path %}
    <a href="{{ site.impressum_path | relative_url }}">{% if footer_lang == 'de' %}Impressum{% else %}Legal notice{% endif %}</a>
    &middot;
  {% endif %}
  {% if site.privacy_path %}
    <a href="{{ site.privacy_path | relative_url }}">{% if footer_lang == 'de' %}Datenschutz{% else %}Privacy{% endif %}</a>
  {% endif %}
  {% if site.enable_cookie_consent %}
    &middot;
    <button type="button" class="cc-settings-link" data-cc="show-preferencesModal">
      {%- if footer_lang == 'de' -%}Cookie-Einstellungen{%- else -%}Cookie settings{%- endif -%}
    </button>
  {% endif %}
  {% if site.last_updated %}
    {% if footer_lang == 'de' %}Zuletzt aktualisiert: {% else %}Last updated: {% endif %}{{ 'now' | localized_date: 'long' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
